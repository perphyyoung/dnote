{
  "name": "dnote",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "release": "tauri build --config src-tauri/tauri.release.conf.json",
    "build": "vite build",
    "build:stable": "node scripts/build-stable-mtime.mjs",
    "build:rs": "cargo build --manifest-path src-tauri/Cargo.toml",
    "gen:bindings": "node scripts/gen-bindings.mjs",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p e2e",
    "format": "pnpm format:ui && pnpm format:rs",
    "format:ui": "oxfmt src/ e2e/",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt src/ e2e/ --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "oxlint --deny-warnings src e2e scripts",
    "lint:fix": "oxlint --fix src e2e scripts",
    "test": "pnpm test:ui && pnpm test:rs",
    "test:ui": "vitest run --reporter=dot",
    "test:rs": "cargo test --quiet --manifest-path src-tauri/Cargo.toml",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "quick": "pnpm format:check && pnpm lint && sentrux check . && pnpm typecheck",
    "check": "pnpm format && pnpm lint && sentrux check . && pnpm build:rs && pnpm gen:bindings && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "6.0.10",
    "autoprefixer": "^10.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.4",
    "tailwindcss": "^3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
